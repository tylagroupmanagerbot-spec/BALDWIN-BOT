const fs = require('fs');
const path = require('path');
const loadCommands = require('../lib/commandLoader');

const command = {
  meta: {
    name: 'help',
    aliases: ['menu', 'commands']
  },
  async run({ bot, msg, args, config }) {
    const commandsDir = path.join(__dirname, '..', 'commands');
    const commandMap = loadCommands(commandsDir);
    const list = [...new Set([...commandMap.keys()].filter((name) => name !== 'help'))].slice(0, 60).sort();

    const lines = [
      `*${config.BOT_NAME}*`,
      `Prefix: *${config.PREFIX}*`,
      `Owner: *${config.OWNER_NAME}*`,
      `Owner Number: *${config.OWNER_NUMBER}*`,
      '',
      'Available commands:',
      list.map((name) => `• ${config.PREFIX}${name}`).join('\n')
    ];

    await bot.sendMessage(msg.key.remoteJid, { text: lines.join('\n') });
  }
};

module.exports = command;

