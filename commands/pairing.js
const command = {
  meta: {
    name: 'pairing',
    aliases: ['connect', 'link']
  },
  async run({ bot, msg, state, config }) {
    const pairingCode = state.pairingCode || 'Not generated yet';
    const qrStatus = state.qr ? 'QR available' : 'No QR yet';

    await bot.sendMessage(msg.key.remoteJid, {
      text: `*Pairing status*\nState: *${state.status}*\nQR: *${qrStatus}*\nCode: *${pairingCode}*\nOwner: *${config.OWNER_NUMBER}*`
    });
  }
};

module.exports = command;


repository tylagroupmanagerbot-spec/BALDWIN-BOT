const command = {
  meta: {
    name: 'botinfo',
    aliases: ['info']
  },
  async run({ bot, msg, config, state }) {
    const text = [
      `*${config.BOT_NAME}*`,
      `Version: *${config.VERSION}*`,
      `Status: *${state.status}*`,
      `Prefix: *${config.PREFIX}*`,
      `Owner: *${config.OWNER_NAME}*`,
      `Owner Number: *${config.OWNER_NUMBER}*`
    ].join('\n');

    await bot.sendMessage(msg.key.remoteJid, { text });
  }
};

module.exports = command;

