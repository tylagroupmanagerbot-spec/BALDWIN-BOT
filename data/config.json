module.exports = {
  name: 'unban',
  aliases: ['unblock'],
  description: 'Unblock a user number',
  async run({ bot, msg, args }) {
    const target = args[0] || msg.message.extendedTextMessage?.contextInfo?.participant;
    if (!target) return bot.sendMessage(msg.key.remoteJid, { text: 'Provide a number or mention a user to unban.' });
    await bot.updateBlockStatus(target, 'unblock');
    await bot.sendMessage(msg.key.remoteJid, { text: `Unblocked: ${target}` });
  }
};
